---
// Nimbo landing. Layout and motion come from Collectify reference components (src/collectify/<slug>),
// colours, type and shapes come from the Nimbo design system (src/styles/nimbo.css).
// Sections: hero Pelmatech · products Travelora · numbers Stepout · steps Prime · pricing Nexwealth ·
// FAQ Rumo · CTA Widgets · footer Schmidt.
import "@fontsource-variable/outfit/wght.css";
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import "../collectify/fluid-tokens/style.css";
import "../collectify/smooth-scroll/style.css";
import "../collectify/smart-navbar/style.css";
import "../collectify/ref-pelmatech-hero/style.css";
import "../collectify/ref-travelora-features/style.css";
import "../collectify/ref-stepout-stats/style.css";
import "../collectify/ref-prime-steps/style.css";
import "../collectify/ref-nexwealth-pricing/style.css";
import "../collectify/ref-rumo-faq/style.css";
import "../collectify/ref-widgets-cta/style.css";
import "../collectify/ref-schmidt-footer/style.css";
import "../styles/nimbo.css";
import { copy } from "../i18n.js";
import { wordmarkSvg } from "../lib/brand.js";
import Hero from "./Hero.astro";
import Products from "./Products.astro";
import Numbers from "./Numbers.astro";
import Steps from "./Steps.astro";
import Pricing from "./Pricing.astro";
import Faq from "./Faq.astro";
import Cta from "./Cta.astro";
import Footer from "./Footer.astro";

const { lang = "it" } = Astro.props;
const t = copy[lang];
const other = lang === "it" ? copy.en : copy.it;
const site = "https://nimbo-pay.vercel.app";
---

<!doctype html>
<html lang={lang} data-cf-scroll-offset="88">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={`${site}${t.path}`} />
    <link rel="alternate" hreflang="it" href={`${site}/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={t.locale.replace("-", "_")} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body data-theme="light">
    <a class="nb-skip" href="#main">{lang === "it" ? "Vai al contenuto" : "Skip to content"}</a>

    <header class="cf-nav nb-nav" data-cf-smart-nav>
      <div class="cf-nav__inner">
        <a class="cf-nav__brand" href={t.path} set:html={wordmarkSvg({ height: 26, label: "Nimbo" })} />
        <nav class="cf-nav__links" id="cf-nav-links" aria-label={t.nav.label}>
          <a href="#prodotti">{t.nav.products}</a>
          <a href="#come">{t.nav.how}</a>
          <a href="#prezzi">{t.nav.pricing}</a>
          <a href="#domande">{t.nav.faq}</a>
        </nav>
        <div class="nb-nav__end">
          <a class="nb-lang" href={other.path} hreflang={lang === "it" ? "en" : "it"} lang={lang === "it" ? "en" : "it"} aria-label={t.nav.langLabel}>{t.nav.langShort}</a>
          <a class="cf-nav__cta" href="#prezzi">{t.nav.cta}</a>
          <button class="cf-nav__toggle" type="button" data-cf-nav-toggle aria-expanded="false" aria-controls="cf-nav-links">{t.nav.menu}</button>
        </div>
      </div>
    </header>

    <main id="main">
      <Hero t={t} lang={lang} />
      <Products t={t} lang={lang} />
      <Numbers t={t} lang={lang} />
      <Steps t={t} lang={lang} />
      <Pricing t={t} lang={lang} />
      <Faq t={t} lang={lang} />
      <Cta t={t} lang={lang} />
    </main>

    <Footer t={t} lang={lang} />

    <script>
      import initSmoothScroll from "../collectify/smooth-scroll/script.js";
      import initSmartNav from "../collectify/smart-navbar/script.js";
      import initHero from "../collectify/ref-pelmatech-hero/script.js";
      import initProducts from "../collectify/ref-travelora-features/script.js";
      import initNumbers from "../collectify/ref-stepout-stats/script.js";
      import initSteps from "../collectify/ref-prime-steps/script.js";
      import initPricing from "../collectify/ref-nexwealth-pricing/script.js";
      import initFaq from "../collectify/ref-rumo-faq/script.js";
      import initCta from "../collectify/ref-widgets-cta/script.js";
      import initFooter from "../collectify/ref-schmidt-footer/script.js";
      import initMarkLife from "../lib/mark-life.js";

      initSmoothScroll();
      initSmartNav();
      initHero();
      initProducts();
      initNumbers();
      initSteps();
      initPricing();
      initFaq();
      initCta();
      initFooter();
      initMarkLife();
    </script>
  </body>
</html>
