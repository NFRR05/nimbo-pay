---
// Nimbo landing. Colours, type and shapes come from the Nimbo design system (src/styles/nimbo.css).
// Numbers and security are Nimbo's own (src/styles/sections.css); hero, products, pricing, FAQ, final call
// to action and footer keep the layout of Collectify reference components (src/collectify/<slug>):
// hero Pelmatech · bento Finax · products Travelora (the stacking cards) · FAQ Rumo · pricing Nexwealth · CTA Dark ·
// footer Schmidt.
// Motion from Collectify: stat-odometer (numbers), hero-line-reveal (section titles), scroll-reveal (the rest).
import "@fontsource-variable/outfit/wght.css";
import "@fontsource-variable/inter/wght.css";
import "../collectify/fluid-tokens/style.css";
import "../collectify/smart-navbar/style.css";
import "../collectify/ref-pelmatech-hero/style.css";
import "../collectify/stat-odometer/style.css";
import "../collectify/ref-finax-bento/style.css";
import "../collectify/scroll-reveal/style.css";
import "../collectify/hero-line-reveal/style.css";
import "../collectify/ref-travelora-features/style.css";
import "../collectify/ref-nexwealth-pricing/style.css";
import "../collectify/ref-rumo-faq/style.css";
import "../collectify/ref-dark-cta/style.css";
import "../collectify/ref-schmidt-footer/style.css";
import "../styles/nimbo.css";
import "../styles/sections.css";
import { copy } from "../i18n.js";
import { wordmarkSvg } from "../lib/brand.js";
import Hero from "./Hero.astro";
import Products from "./Products.astro";
import Numbers from "./Numbers.astro";
import Talk from "./Talk.astro";
import Bento from "./Bento.astro";
import Security from "./Security.astro";
import Pricing from "./Pricing.astro";
import Faq from "./Faq.astro";
import Cta from "./Cta.astro";
import Footer from "./Footer.astro";

const { lang = "it" } = Astro.props;
const t = copy[lang];
const other = lang === "it" ? copy.en : copy.it;
const site = "https://nimbo-pay.vercel.app";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={`${site}${t.path}`} />
    <link rel="alternate" hreflang="it" href={`${site}/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={t.locale.replace("-", "_")} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body data-theme="light">
    <a class="nb-skip" href="#main">{lang === "it" ? "Vai al contenuto" : "Skip to content"}</a>

    <header class="cf-nav nb-nav" data-cf-smart-nav>
      <div class="cf-nav__inner">
        <a class="cf-nav__brand" href={t.path} set:html={wordmarkSvg({ height: 26, label: "Nimbo" })} />
        <nav class="cf-nav__links" id="cf-nav-links" aria-label={t.nav.label}>
          <a href="#prodotti">{t.nav.products}</a>
          <a href="#sicurezza">{t.nav.security}</a>
          <a href="#domande">{t.nav.faq}</a>
          <a href="#prezzi">{t.nav.pricing}</a>
        </nav>
        <div class="nb-nav__end">
          <a class="nb-lang" href={other.path} hreflang={lang === "it" ? "en" : "it"} lang={lang === "it" ? "en" : "it"} aria-label={t.nav.langLabel}>{t.nav.langShort}</a>
          <a class="cf-nav__cta" href="#finale">{t.nav.cta}</a>
          <button class="cf-nav__toggle" type="button" data-cf-nav-toggle data-cf-nav-open={t.nav.menu} data-cf-nav-close={t.nav.close} aria-expanded="false" aria-controls="cf-nav-links">{t.nav.menu}</button>
        </div>
      </div>
    </header>

    <main id="main">
      <Hero t={t} lang={lang} />
      <Numbers t={t} lang={lang} />
      <Talk t={t} lang={lang} />
      <Bento t={t} lang={lang} />
      <Products t={t} lang={lang} />
      <Security t={t} lang={lang} />
      <Faq t={t} lang={lang} />
      <Pricing t={t} lang={lang} />
      <Cta t={t} lang={lang} />
    </main>

    <Footer t={t} lang={lang} />

    <script>
      import initSmartNav from "../collectify/smart-navbar/script.js";
      import initHero from "../collectify/ref-pelmatech-hero/script.js";
      import initOdometer from "../collectify/stat-odometer/script.js";
      import initBento from "../collectify/ref-finax-bento/script.js";
      import initScrollReveal from "../collectify/scroll-reveal/script.js";
      import initLineReveal from "../collectify/hero-line-reveal/script.js";
      import initWordFill from "../collectify/scroll-word-fill/script.js";
      import initTalk from "../lib/talk.js";
      import initProducts from "../collectify/ref-travelora-features/script.js";
      import initPricing from "../collectify/ref-nexwealth-pricing/script.js";
      import initFaq from "../collectify/ref-rumo-faq/script.js";
      import initCta from "../collectify/ref-dark-cta/script.js";
      import initPerch from "../lib/perch.js";
      import initRecon from "../lib/recon-app.js";
      import initBentoLive from "../lib/bento-live.js";
      import initCard3d from "../lib/card3d.js";

      initSmartNav();
      initHero();
      initOdometer();
      initBento();
      initRecon();
      initBentoLive();
      initCard3d();
      initScrollReveal();
      initLineReveal();
      initWordFill();
      initTalk();
      initProducts();
      initPricing();
      initFaq();
      initCta();
      initPerch();
      // The 3D marks (Three.js) load on their own, after the page, when the browser has a moment free. With reduced
      // motion, or on a very weak device (two cores or two gigabytes), the posters are the frame and the library
      // isn't loaded at all.
      const weak = (navigator.hardwareConcurrency || 8) <= 2 || (navigator.deviceMemory || 8) <= 2;
      if (!weak && !window.matchMedia("(prefers-reduced-motion: reduce)").matches && document.querySelector("[data-nb-marks3d]")) {
        const load3d = () => import("../lib/marks3d.js").then((m) => m.default());
        const whenFree = () => ("requestIdleCallback" in window ? requestIdleCallback(load3d, { timeout: 2500 }) : setTimeout(load3d, 800));
        if (document.readyState === "complete") whenFree();
        else window.addEventListener("load", whenFree, { once: true });
      }
    </script>
  </body>
</html>
