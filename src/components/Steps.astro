---
// How it works: layout and motion of Collectify «ref-prime-steps» (src/collectify/ref-prime-steps),
// redrawn for Nimbo: three dark mini-interfaces (API keys, connectors, first live payment),
// black and white, with the colour marks as the only colour (Capsule on the bridge, three colour marks as live cursors).
import { markSvg } from "../lib/brand.js";
import { iconSvg } from "../lib/icons.js";
import copy from "../copy/steps.js";

const { lang = "it" } = Astro.props;
const c = copy[lang] || copy.it;
const u = c.ui;
const cursorMarks = ["coin", "token", "card"];
const check = `<svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="6" fill="#111"/><path d="M3.4 6.2 5.2 8l3.4-3.6" fill="none" stroke="#fff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const arrow = (dir) =>
  dir === "left"
    ? `<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M10.8 1.2 1.4 4.6l4.2 1.8 1.8 4.2Z"/></svg>`
    : `<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1.2 1.2 10.6 4.6 6.4 6.4 4.6 10.6Z"/></svg>`;
---

<section class="cf-pd" id="come" data-cf-pd aria-labelledby="steps-title">
  <div class="cf-pd__frame">
    <header class="cf-pd__head">
      <p class="cf-pd__eyebrow" data-cf-pd-in="head"><span class="cf-pd__slashes" aria-hidden="true">//</span> <span data-cf-pd-type>{c.eyebrow}</span></p>
      <h2 class="cf-pd__title" id="steps-title" data-cf-pd-in="head">{c.title}</h2>
    </header>

    <span class="cf-pd__rule" aria-hidden="true" data-cf-pd-in="rule"></span>

    <ol class="cf-pd__steps">
      <!-- 1 — API keys -->
      <li class="cf-pd__step" data-cf-pd-step>
        <div class="cf-pd__shot cf-pd__keys" aria-hidden="true" data-cf-pd-in="shot">
          <div class="cf-pd__keys-panel">
            <p class="cf-pd__keys-title">{u.keysTitle}</p>
            <span class="cf-pd__keys-env"><i></i>{u.keysEnv}</span>
            <div class="cf-pd__keys-list">
              <div class="cf-pd__key" style="--y: 14">
                <small>{u.keyPublic}</small>
                <code>pk_test_51Nb0x8Qe…4f9a</code>
                <span class="cf-pd__key-copy">{u.copy}</span>
              </div>
              <div class="cf-pd__key" style="--y: 64">
                <small>{u.keySecret}</small>
                <code>sk_test_••••••••••7c2e</code>
                <span class="cf-pd__key-copy">{u.copy}</span>
              </div>
            </div>
          </div>
          <div class="cf-pd__pop" data-cf-pd-pop>
            <p class="cf-pd__pop-title"><Fragment set:html={check} />{u.toastTitle}</p>
            <p class="cf-pd__pop-time">{u.toastText}</p>
            <p class="cf-pd__pop-row">{u.toastRow}</p>
          </div>
        </div>
        <p class="cf-pd__chip" data-cf-pd-in="chip">{c.stepLabel} 01</p>
        <h3 class="cf-pd__step-title" data-cf-pd-in="text">{c.steps[0].title}</h3>
        <p class="cf-pd__text" data-cf-pd-in="text">{c.steps[0].text}</p>
      </li>

      <!-- 2 — connectors -->
      <li class="cf-pd__step" data-cf-pd-step>
        <div class="cf-pd__shot cf-pd__chat" aria-hidden="true" data-cf-pd-in="shot">
          <div class="cf-pd__chat-side">
            <p class="cf-pd__chat-team">{u.side} <i>⌄</i></p>
            <ul class="cf-pd__chat-menu">
              {u.menu.map((m, i) => <li class={i === 2 ? "is-active" : undefined}><b></b>{m}</li>)}
            </ul>
            <ul class="cf-pd__chat-channels">
              <li class="cf-pd__chat-label">{u.groups}</li>
              <li class="is-active"># {u.envs[0]}</li>
              <li># {u.envs[1]}</li>
            </ul>
          </div>
          <div class="cf-pd__chat-main">
            <p class="cf-pd__chat-channel">{u.connTitle} <i>⌄</i></p>
            <div class="cf-pd__chat-apps">
              <span class="cf-pd__chat-nimbi" set:html={markSvg("capsule", { size: 40 })} />
              <b>+</b>
              <span set:html={iconSvg("bank", { size: 14 })} />
            </div>
            {u.conns.map(([name, meta, status], i) => (
              <div class="cf-pd__msg" data-cf-pd-msg>
                <span class="cf-pd__avatar" set:html={iconSvg(i === 0 ? "bank" : "transfer", { size: 12 })} />
                <p><b>{name}</b> <small>{meta}</small></p>
                <span class="cf-pd__msg-status">{status}</span>
              </div>
            ))}
            <div class="cf-pd__chat-input">
              <span class="cf-pd__chat-plus">+</span>
              {u.connInput}
            </div>
          </div>
        </div>
        <p class="cf-pd__chip" data-cf-pd-in="chip">{c.stepLabel} 02</p>
        <h3 class="cf-pd__step-title" data-cf-pd-in="text">{c.steps[1].title}</h3>
        <p class="cf-pd__text" data-cf-pd-in="text">{c.steps[1].text}</p>
      </li>

      <!-- 3 — first live payment, with three mark as live cursors -->
      <li class="cf-pd__step" data-cf-pd-step>
        <div class="cf-pd__shot cf-pd__live" aria-hidden="true" data-cf-pd-in="shot">
          <div class="cf-pd__live-card">
            <p class="cf-pd__live-title">{u.liveTitle}<span><i></i>Live</span></p>
            <p class="cf-pd__live-amount">{u.liveAmount}</p>
            <p class="cf-pd__live-meta">{u.liveMeta}</p>
            <div class="cf-pd__live-track"><span></span></div>
            <ul class="cf-pd__live-stages">
              {u.liveStages.map((s, i) => (
                <li><b>{s}</b><small>{u.liveTimes[i]}</small></li>
              ))}
            </ul>
          </div>
          {u.cursors.map((name, i) => (
            <span class={`cf-pd__cursor cf-pd__cursor--${["a", "b", "c"][i]}`} data-cf-pd-cursor>
              <Fragment set:html={arrow(i === 0 ? "right" : "left")} />
              <span class="cf-pd__cursor-tag"><span set:html={markSvg(cursorMarks[i], { size: 18 })} />{name}</span>
            </span>
          ))}
        </div>
        <p class="cf-pd__chip" data-cf-pd-in="chip">{c.stepLabel} 03</p>
        <h3 class="cf-pd__step-title" data-cf-pd-in="text">{c.steps[2].title}</h3>
        <p class="cf-pd__text" data-cf-pd-in="text">{c.steps[2].text}</p>
      </li>
    </ol>

    <ul class="cf-pd__perks" aria-label={c.perksLabel} data-cf-pd-in="perks">
      {c.perks.map((p, i) => (
        <li><Fragment set:html={iconSvg(["code", "shield", "clock"][i], { size: 22 })} />{p}</li>
      ))}
    </ul>
  </div>
</section>
