---
// Hero: what Nimbo is, two actions, and one real-looking product moment: a sandbox payment
// request and its response, with the CO₂ receipt in the last line. Static, no animation.
import copy from "../copy/hero.js";

const { lang = "it" } = Astro.props;
const h = copy[lang] || copy.it;
const arrow = `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 12h15M13.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
---

<section class="nb-hero" data-theme="light" aria-labelledby="hero-title">
  <div class="nb-wrap nb-hero__grid">
    <div class="nb-hero__copy">
      <h1 class="nb-hero__title" id="hero-title">{h.title}</h1>
      <p class="nb-hero__lede">{h.lede}</p>
      <div class="nb-actions">
        <a class="nb-btn nb-btn--solid" href="#finale">{h.primary}<Fragment set:html={arrow} /></a>
        <a class="nb-btn nb-btn--line" href="#prezzi">{h.secondary}<Fragment set:html={arrow} /></a>
      </div>
    </div>

    <figure class="nb-console" aria-label={h.consoleLabel}>
      <figcaption class="nb-console__bar"><span>{h.env}</span><span>sk_test_••••4f2a</span></figcaption>
      <div class="nb-console__block">
        <p class="nb-console__label">{h.request}</p>
        <pre><code><span class="m">POST</span> /v1/payments
<span class="k">Idempotency-Key:</span> 9b2e7c41-5d0a-4e3f
{"{"}
  <span class="k">"amount":</span> 125000,
  <span class="k">"currency":</span> "EUR",
  <span class="k">"scheme":</span> "sct_inst",
  <span class="k">"creditor":</span> {"{"}
    <span class="k">"name":</span> "Verdi S.p.A.",
    <span class="k">"iban":</span> "IT60X0542811101000000123456"
  {"}"}
{"}"}</code></pre>
      </div>
      <div class="nb-console__block">
        <p class="nb-console__label">{h.response}<b>{h.status}</b></p>
        <pre><code>{"{"}
  <span class="k">"id":</span> "pay_7Hq2LxV4nR",
  <span class="k">"status":</span> "settled",
  <span class="k">"settled_at":</span> "2026-11-02T09:41:07Z",
  <span class="hl"><span class="k">"co2_grams":</span> 0.4</span>
{"}"}</code></pre>
      </div>
    </figure>
  </div>
</section>
