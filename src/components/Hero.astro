---
// Hero: layout and motion of Collectify «ref-pelmatech-hero» (src/collectify/ref-pelmatech-hero),
// redrawn with the Nimbo identity. The blurred figure behind the ribbed glass becomes the five Nimbi:
// they are the only colour on the page, and the one that matches the active point comes into focus.
import { nimbiSvg, NIMBI } from "../lib/brand.js";
import { iconSvg } from "../lib/icons.js";
import copy from "../copy/hero.js";

const { lang = "it" } = Astro.props;
const h = copy[lang];
const icons = ["clock", "euro", "shield", "check", "code"];
const upRight = `<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
---

<section class="cf-pm" data-cf-pm data-theme="dark" aria-labelledby="hero-title">
  <div class="cf-pm__bg" aria-hidden="true">
    <div class="cf-pm__bg-img" data-cf-pm-bg>
      {NIMBI.map((c, i) => (
        <div class={`cf-pm__nimbi cf-pm__nimbi--${i + 1}`} data-cf-pm-nimbi set:html={nimbiSvg(c, { size: 400 })} />
      ))}
    </div>
  </div>

  <div class="cf-pm__inner">
    <aside class="cf-pm__panel" aria-label={h.panelLabel}>
      <div class="cf-pm__panel-in" data-cf-pm-in="panel">
        <span class="cf-pm__handle" aria-hidden="true"></span>
        <p class="cf-pm__address">
          <Fragment set:html={iconSvg("bank", { size: 14 })} />
          {h.account}
        </p>

        <ul class="cf-pm__slots">
          {h.slots.map((s) => (
            <li class="cf-pm__slot" data-cf-pm-in="slot">
              <div class="cf-pm__slot-head">
                <h2 class="cf-pm__day">{s.name}</h2>
                <span class="cf-pm__level">{s.kind}</span>
              </div>
              <dl class="cf-pm__times">
                <div class="cf-pm__time">
                  <dt>{s.from[0]}</dt>
                  <dd>{s.from[1]}</dd>
                </div>
                <div class="cf-pm__dur">
                  <dt class="cf-pm__sr">{h.tookLabel}</dt>
                  <dd>{s.took}</dd>
                </div>
                <div class="cf-pm__time cf-pm__time--end">
                  <dt>{s.to[0]}</dt>
                  <dd>{s.to[1]}</dd>
                </div>
              </dl>
              <span class="cf-pm__ruler" aria-hidden="true"></span>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <div class="cf-pm__body">
      <h1 class="cf-pm__title" id="hero-title">
        {h.title.map((line) => (
          <>
            <span class="cf-pm__line"><span class="cf-pm__line-in" data-cf-pm-in="line">{line}</span></span>{" "}
          </>
        ))}
      </h1>

      <div class="cf-pm__row">
        <p class="cf-pm__lede" data-cf-pm-in="copy">{h.lede}</p>

        <div class="cf-pm__actions" data-cf-pm-in="copy">
          <a class="cf-pm__btn" href="#prezzi">{h.primary}<Fragment set:html={upRight} /></a>
          <a class="cf-pm__link" href="#come">{h.secondary}<Fragment set:html={upRight} /></a>
        </div>
      </div>
    </div>

    <div class="cf-pm__features">
      <span class="cf-pm__progress" aria-hidden="true" data-cf-pm-progress><span></span></span>
      <ul aria-label={h.featuresLabel}>
        {h.features.map((f, i) => (
          <li class={i === 0 ? "cf-pm__feature is-active" : "cf-pm__feature"} data-cf-pm-in="feature" data-cf-pm-feature>
            <Fragment set:html={iconSvg(icons[i], { size: 16 })} />
            <p>{f[0]} <br class="cf-pm__br" />{f[1]}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
