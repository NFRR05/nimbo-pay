---
// Pricing: layout of Collectify «ref-nexwealth-pricing» (src/collectify/ref-nexwealth-pricing), reduced for Nimbo.
// Three plans side by side, the usage plan in black; a volume switch (transactions a month) updates the
// Scale estimate straight away: 0,05 € per transaction above the free 10.000.
import { iconSvg } from "../lib/icons.js";
import copy from "../copy/pricing.js";

const { t, lang = "it" } = Astro.props;
const c = copy[lang] || copy.it;
const locale = t?.locale || (lang === "en" ? "en-IE" : "it-IT");
const euro = new Intl.NumberFormat(locale, { style: "currency", currency: "EUR", maximumFractionDigits: 0, useGrouping: "always" });
const num = new Intl.NumberFormat(locale);
const estimate = (n) => Math.max(0, n - 10000) * 0.05;
const arrow = iconSvg("arrow-right", { size: 16 });
const check = iconSvg("check", { size: 18, className: "cf-nx__check" });
---

<section class="cf-nx" id="prezzi" data-cf-nx data-cf-nx-locale={locale} data-theme="light" aria-labelledby="cf-nx-title">
  <div class="nb-wrap">
    <div class="cf-nx__head">
      <header class="nb-head">
        <h2 class="nb-h2" id="cf-nx-title" data-cf-line-reveal="scroll">{c.title}</h2>
        <p class="nb-lede" data-cf-reveal>{c.lede}</p>
      </header>

      <div class="cf-nx__volume" data-cf-reveal>
        <span class="cf-nx__volume-label" id="cf-nx-volume-label">{c.volumeLabel}</span>
        <div class="cf-nx__period" role="group" aria-labelledby="cf-nx-volume-label">
          {c.volumes.map((v) => (
            <button class="cf-nx__period-btn" type="button" aria-pressed={v === c.defaultVolume ? "true" : "false"} data-cf-nx-volume={v}>{num.format(v)}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="cf-nx__plans" role="group" aria-label={c.plansLabel} tabindex="0">
      {c.plans.map((p) => (
        <article class={p.kind === "usage" ? "cf-nx__card cf-nx__card--pro" : "cf-nx__card"} data-theme={p.kind === "usage" ? "dark" : undefined} aria-labelledby={`cf-nx-${p.id}`} data-cf-reveal>
          <div class="cf-nx__top">
            <h3 class="cf-nx__name" id={`cf-nx-${p.id}`}>{p.name}</h3>
            {p.flag && <p class="cf-nx__flag">{p.flag}</p>}
          </div>
          <div class="cf-nx__amount">
            {p.kind === "fixed" && (
              <p class="cf-nx__price"><span>{euro.format(p.price)}</span> <small>{p.per}</small></p>
            )}
            {p.kind === "usage" && (
              <>
                <p class="cf-nx__price"><span data-cf-nx-price>{euro.format(estimate(c.defaultVolume))}</span> <small>{p.per}</small></p>
                <p class="cf-nx__est" aria-live="polite" data-cf-nx-est={p.estimate}>{p.estimate.replace("{n}", num.format(c.defaultVolume))}</p>
              </>
            )}
            {p.kind === "custom" && <p class="cf-nx__price">{p.priceText}</p>}
          </div>
          <p class="cf-nx__desc">{p.desc}</p>
          <a class="nb-btn nb-btn--block cf-nx__cta" href="#finale">{p.cta}<Fragment set:html={arrow} /></a>
          <h4 class="cf-nx__inc">{c.included}</h4>
          <ul class="cf-nx__list" role="list">
            {p.features.map((f) => (
              <li><Fragment set:html={check} />{f}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <p class="cf-nx__note">{c.note}</p>
  </div>
</section>
