---
// Bento: layout and motion of Collectify «ref-finax-bento» (src/collectify/ref-finax-bento),
// redrawn with the Nimbo identity: black and white UI, Phosphor Fill icons, the Nimbi as the only colour.
import { nimbiSvg } from "../lib/brand.js";
import { iconSvg } from "../lib/icons.js";

const { t } = Astro.props;
const b = t.bento;
const tr = b.treasury;
const fmt = new Intl.NumberFormat(t.locale, { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
const pins = [
  ["FR", 225, 176],
  ["IT", 188.5, 218.5],
  ["DE", 284, 245],
];
const fees = [
  [94, 211, -8],
  [262.5, 199, -6],
  [456, 210, 0],
  [105, 265.5, 5],
  [299, 257.5, 10],
  [478, 256, -12],
  [117, 319, -4],
  [284, 312.5, 7],
  [434, 313, 9],
];
// Coin sits in the right ring of the infinity: «time is money»
const coin = nimbiSvg("coin", { size: 70 }).replace("<svg ", '<svg x="197" y="212" ');
---

<section class="cf-fx" id="perche" data-cf-fx aria-labelledby="bento-title">
  <div class="cf-fx__panel">
    <header class="cf-fx__head">
      <p class="cf-fx__label" data-cf-fx-in="head">{b.label}</p>
      <h2 class="cf-fx__title" id="bento-title" data-cf-fx-in="head">{b.title}</h2>
    </header>

    <div class="cf-fx__grid">
      <!-- 1. Instant transfers -->
      <article class="cf-fx__card cf-fx__card--third" data-cf-fx-in="card">
        <div class="cf-fx__in">
          <div class="cf-fx__text">
            <Fragment set:html={iconSvg("globe", { className: "cf-fx__icon" })} />
            <h3 class="cf-fx__h3">{b.sepa.title}</h3>
            <p class="cf-fx__p">{b.sepa.text}</p>
          </div>
          <div class="cf-fx__stage cf-fx-map" aria-hidden="true">
            <img class="cf-fx-map__dots" src="/media/map-dots.webp" alt="" width="714" height="300" loading="lazy" decoding="async" />
            <svg class="cf-fx-map__routes" viewBox="0 0 357 335"><path d="M249 195c26 2 46 16 48 50" data-cf-fx-route /><path d="M213 231c40-12 78-8 84 14" data-cf-fx-route /></svg>
            {pins.map(([code, x, y]) => (
              <span class="cf-fx-pin" style={`--x: ${x}; --y: ${y}`} data-cf-fx-pin>{code}</span>
            ))}
            <div class="cf-fx-bank" data-cf-fx-bank>
              <div class="cf-fx-bank__top">
                <span class="cf-fx-bank__ico" set:html={iconSvg("bank", { size: 10 })} />
                <span class="cf-fx-bank__free">{b.sepa.tag}</span>
              </div>
              <p class="cf-fx-bank__name">{b.sepa.name}</p>
              <div class="cf-fx-bank__route">
                <span class="cf-fx-bank__cc">IT</span>
                <i>···</i><b>→</b><i>···</i>
                <span class="cf-fx-bank__cc">DE</span>
              </div>
              <p class="cf-fx-bank__label">{b.sepa.label}</p>
              <p class="cf-fx-bank__amount">{b.sepa.amount}</p>
              <p class="cf-fx-bank__eta">{b.sepa.eta}</p>
            </div>
          </div>
        </div>
      </article>

      <!-- 2. Time is money: reconciliation -->
      <article class="cf-fx__card cf-fx__card--third" data-cf-fx-in="card">
        <div class="cf-fx__in">
          <div class="cf-fx__text">
            <Fragment set:html={iconSvg("clock", { className: "cf-fx__icon" })} />
            <h3 class="cf-fx__h3">{b.recon.title}</h3>
            <p class="cf-fx__p">{b.recon.text}</p>
          </div>
          <div class="cf-fx__stage cf-fx-inf" aria-hidden="true">
            <svg viewBox="0 0 356 335">
              <defs>
                <radialGradient id="cf-fx-disc" cx="0.62" cy="0.7" r="0.75"><stop offset="0" stop-color="#ffffff" /><stop offset="0.55" stop-color="#f1f1f0" /><stop offset="1" stop-color="#e3e3e1" /></radialGradient>
              </defs>
              <circle cx="122.5" cy="248.5" r="37" fill="url(#cf-fx-disc)" />
              <circle cx="230" cy="247.5" r="37" fill="url(#cf-fx-disc)" />
              <g class="cf-fx-inf__ring" data-cf-fx-spin="-1" style="transform-origin: 122.5px 248.5px">
                <path d="M122.5 202.5a46 46 0 1 0 34 77" class="cf-fx-inf__main" />
                <path d="M97 197a56 56 0 0 1 75 6" class="cf-fx-inf__soft" />
                <path d="M74 284a62 62 0 0 0 98 2" class="cf-fx-inf__faint" />
                <path d="M62 225a64 64 0 0 1 22-33" class="cf-fx-inf__faint" />
              </g>
              <g class="cf-fx-inf__ring" data-cf-fx-spin="1" style="transform-origin: 230px 247.5px">
                <path d="M230 293.5a46 46 0 1 0-34-77" class="cf-fx-inf__main" />
                <path d="M254 194a56 56 0 0 1 32 40" class="cf-fx-inf__soft" />
                <path d="M180 286a62 62 0 0 0 85 14" class="cf-fx-inf__soft" />
                <path d="M288 215a66 66 0 0 1 4 54" class="cf-fx-inf__faint" />
              </g>
              <path class="cf-fx-inf__main" d="M156.5 279.5c10 10 18 14 27 14M196 216.5c-10-10-18-14-27-14" />
              <g class="cf-fx-inf__clock">
                <line class="cf-fx-inf__hand" x1="122.5" y1="248.5" x2="122.5" y2="213" data-cf-fx-hand style="transform-origin: 122.5px 248.5px" />
                <line class="cf-fx-inf__hand" x1="116" y1="248.5" x2="101" y2="248.5" />
                <circle cx="122.5" cy="248.5" r="6.4" class="cf-fx-inf__hand" />
              </g>
              <g class="cf-fx-inf__coin" set:html={coin} />
            </svg>
          </div>
        </div>
      </article>

      <!-- 3. Pricing -->
      <article class="cf-fx__card cf-fx__card--third" data-cf-fx-in="card">
        <div class="cf-fx__in">
          <div class="cf-fx__text">
            <Fragment set:html={iconSvg("euro", { className: "cf-fx__icon" })} />
            <h3 class="cf-fx__h3">{b.plans.title}</h3>
            <p class="cf-fx__p">{b.plans.text}</p>
          </div>
          <div class="cf-fx__stage cf-fx-plans" aria-hidden="true">
            <div class="cf-fx-plan" style="--x: 51; --y: 162.5" data-cf-fx-plan><b>{b.plans.rows[0][0]}</b><span>{b.plans.rows[0][1]}</span></div>
            <div class="cf-fx-plan" style="--x: 51; --y: 263.5" data-cf-fx-plan><b>{b.plans.rows[1][0]}</b><span>{b.plans.rows[1][1]}</span></div>
            <div class="cf-fx-plan cf-fx-plan--trial" style="--x: 129.5; --y: 216.5" data-cf-fx-trial><b>{b.plans.trial[0]}</b><span>{b.plans.trial[1]}</span></div>
          </div>
        </div>
      </article>

      <!-- 4. Treasury -->
      <article class="cf-fx__card cf-fx__card--half" data-cf-fx-in="card">
        <div class="cf-fx__in cf-fx__in--wide">
          <div class="cf-fx__text">
            <Fragment set:html={iconSvg("bank", { className: "cf-fx__icon" })} />
            <h3 class="cf-fx__h3">{tr.title}</h3>
            <p class="cf-fx__p">{tr.text}</p>
          </div>
          <div class="cf-fx__stage cf-fx-chart" aria-hidden="true">
            <ul class="cf-fx-chart__y">{tr.axis.map((a) => <li>{a}</li>)}</ul>
            <svg class="cf-fx-chart__svg" viewBox="0 0 546 337">
              <defs>
                <linearGradient id="cf-fx-area" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e3e3e1" /><stop offset="1" stop-color="#f6f6f5" stop-opacity="0" /></linearGradient>
              </defs>
              <path class="cf-fx-chart__area" d="M81 283C100 262 116 256 132 256s38 22 62 23c24 1 34-12 48-25 14-13 30-18 50-18s34 18 50 32c12 10 24 9 40 0 18-10 22-35 48-48 28-14 64-12 86-33 10-9 20-16 30-20V337H81Z" fill="url(#cf-fx-area)" />
              <path class="cf-fx-chart__line" d="M81 283C100 262 116 256 132 256s38 22 62 23c24 1 34-12 48-25 14-13 30-18 50-18s34 18 50 32c12 10 24 9 40 0 18-10 22-35 48-48 28-14 64-12 86-33 10-9 20-16 30-20" pathLength="1" data-cf-fx-line />
              <line class="cf-fx-chart__drop" x1="292" y1="244" x2="292" y2="337" />
            </svg>
            <span class="cf-fx-chart__dot" data-cf-fx-dot></span>
            <div class="cf-fx-chart__tip" data-cf-fx-tip>
              <b data-cf-fx-amount={tr.amount} data-cf-fx-locale={t.locale}>{fmt.format(tr.amount)}</b>
              <span><svg viewBox="0 0 24 24"><path d="M22 7 13.5 15.5 8.5 10.5 2 17M16 7h6v6" /></svg><em>{tr.delta}</em> {tr.vs}</span>
            </div>
            <div class="cf-fx-phone" data-cf-fx-phone>
              <div class="cf-fx-phone__screen">
                <div class="cf-fx-phone__status"><span>9:41</span><i></i><span class="cf-fx-phone__sig">▮▮▮</span></div>
                <div class="cf-fx-phone__bar"><span class="cf-fx-phone__back">‹</span><b>{tr.app}</b><span class="cf-fx-phone__ava" set:html={nimbiSvg("token", { size: 14 })} /></div>
                <div class="cf-fx-phone__box">
                  <small>{tr.avail}</small>
                  <b>{tr.availValue}</b>
                  <span class="cf-fx-phone__meter"><span></span></span>
                  <small class="cf-fx-phone__tiny">{tr.forecast}</small>
                </div>
                <div class="cf-fx-phone__row"><b>{tr.insights}</b><span>{tr.all}</span></div>
                <div class="cf-fx-phone__cols">
                  <div class="cf-fx-phone__tile">
                    <b>{tr.diff}</b>
                    <div class="cf-fx-phone__bars">
                      <span><small>{tr.inLabel}<br />{tr.inValue}</small><i></i></span>
                      <span><small>{tr.outLabel}<br />{tr.outValue}</small><i></i></span>
                    </div>
                  </div>
                  <div class="cf-fx-phone__tile">
                    <b>{tr.growth}</b>
                    <svg viewBox="0 0 60 40"><path d="M2 30c6-6 9 0 14-3s6-8 11-4 7 2 12-3 9-3 12-9 5-4 7-6" fill="none" stroke="#111" stroke-width="1.2" /></svg>
                  </div>
                </div>
                <b class="cf-fx-phone__foot">{tr.foot}</b>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- 5. No hidden costs -->
      <article class="cf-fx__card cf-fx__card--half" data-cf-fx-in="card">
        <div class="cf-fx__in cf-fx__in--wide">
          <div class="cf-fx__text">
            <Fragment set:html={iconSvg("check", { className: "cf-fx__icon" })} />
            <h3 class="cf-fx__h3">{b.fees.title}</h3>
            <p class="cf-fx__p">{b.fees.text}</p>
          </div>
          <ul class="cf-fx__stage cf-fx-fees" aria-label={b.fees.label}>
            {b.fees.items.map((item, i) => (
              <li class="cf-fx-fee" style={`--x: ${fees[i][0]}; --y: ${fees[i][1]}; --r: ${fees[i][2]}deg`}>
                <span class="cf-fx-fee__pill" data-cf-fx-fee><s>{item}</s></span>
              </li>
            ))}
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>
