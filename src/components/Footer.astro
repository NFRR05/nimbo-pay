---
// Footer: layout of Collectify «ref-schmidt-footer» (src/collectify/ref-schmidt-footer), reduced for Nimbo:
// a dark card with the menu on the left, language and a line about Nimbo on the right, and the nimbo
// wordmark across the bottom, flat and sharp. No glow, no blur.
import copy from "../copy/footer.js";
import { wordmarkSvg } from "../lib/brand.js";

const { lang = "it" } = Astro.props;
const f = copy[lang] || copy.it;
---

<footer class="cf-sc" data-cf-sc data-theme="dark">
  <div class="cf-sc__card">
    <div class="cf-sc__top">
      <nav class="cf-sc__nav" aria-label={f.navLabel}>
        <ul role="list">
          {f.links.map(([label, href]) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="cf-sc__contact">
        <ul class="cf-sc__lang" role="list" aria-label={f.langLabel}>
          <li><a href="/" hreflang="it" lang="it" aria-current={lang === "it" ? "page" : undefined}>Italiano</a></li>
          <li><a href="/en/" hreflang="en" lang="en" aria-current={lang === "en" ? "page" : undefined}>English</a></li>
        </ul>
        <p class="cf-sc__info">{f.info}</p>
      </div>
    </div>

    <div class="cf-sc__word" set:html={wordmarkSvg({ height: 240, label: "Nimbo" })} />
  </div>
  <p class="cf-sc__legal">{f.legal}</p>
</footer>
