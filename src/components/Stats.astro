<section class="cf-wy" data-cf-wy data-cf-wy-locale={t.locale} data-theme="dark" aria-labelledby="stats-title">
  <div class="cf-wy__inner">
    <div class="cf-wy__intro">
      <h2 class="cf-wy__title" id="stats-title">
        {s.lines.map((line) => (
          <>
            <span class="cf-wy__line"><span class="cf-wy__line-in" data-cf-wy-in="line">{line}</span></span>{" "}
          </>
        ))}
      </h2>
      <p class="cf-wy__lede" data-cf-wy-in="copy">{s.lede}</p>
      <a class="cf-wy__btn" href="#prezzi" data-cf-wy-in="copy">
        <span>{s.cta}</span>
        <svg class="cf-wy__chev" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
      </a>
      <svg class="cf-wy__chart" viewBox="0 0 418 222" aria-hidden="true" focusable="false" data-cf-wy-chart>
        <defs>
          <linearGradient id="cf-wy-fill" x1="0" y1="9" x2="0" y2="222" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.22" />
            <stop offset="0.25" stop-color="#ffffff" stop-opacity="0.14" />
            <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.07" />
            <stop offset="0.78" stop-color="#ffffff" stop-opacity="0.02" />
            <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path class="cf-wy__area" data-cf-wy-area d={AREA} />
        <path class="cf-wy__stroke" data-cf-wy-stroke pathLength="1" d={STROKE} />
      </svg>
    </div>

    <div class="cf-wy__stats">
      <div class="cf-wy__hero-stat" data-cf-wy-in="stat">
        <p class="cf-wy__big"><span data-cf-wy-count={s.big.value}>{fmt(s.big.value)}</span></p>
        <p class="cf-wy__label">{s.big.text}</p>
      </div>
      <dl class="cf-wy__grid">
        {s.items.map((it, i) => (
          <div class={i === 3 ? "cf-wy__stat cf-wy__stat--nudge" : "cf-wy__stat"} data-cf-wy-in="stat">
            <dt class="cf-wy__label">{it.text}</dt>
            <dd class="cf-wy__num" data-cf-wy-count={it.value} data-cf-wy-from={it.from} data-cf-wy-decimals={it.decimals} data-cf-wy-prefix={it.prefix} data-cf-wy-suffix={it.suffix}>
              {(it.prefix || "") + fmt(it.value, it.decimals || 0) + (it.suffix || "")}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
