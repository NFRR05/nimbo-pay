---
// FAQ: layout and motion of Collectify «ref-rumo-faq» (src/collectify/ref-rumo-faq),
// redrawn with the Nimbo identity. The coastline photo becomes the five Nimbi standing on a soft floor
// that fades into the section; opening a question makes one of them hop.
import { nimbiSvg, NIMBI } from "../lib/brand.js";
import copy from "../copy/faq.js";

const { lang = "it" } = Astro.props; // also receives t, unused here
const c = copy[lang] || copy.it;
---

<section class="cf-rm" id="domande" data-cf-rm aria-labelledby="cf-rm-title">
  <div class="cf-rm__intro">
    <h2 class="cf-rm__title" id="cf-rm-title">
      {c.lines.map((line) => (
        <>
          <span class="cf-rm__line"><span class="cf-rm__line-in" data-cf-rm-in="line">{line}</span></span>{" "}
        </>
      ))}
    </h2>
    <p class="cf-rm__sub" data-cf-rm-in="copy">{c.sub}</p>
    <figure class="cf-rm__photo" role="img" aria-label={c.nimbiLabel} data-cf-rm-in="photo">
      <span class="cf-rm__floor" aria-hidden="true"></span>
      <span class="cf-rm__nimbi" aria-hidden="true">
        {NIMBI.map((n) => <span class="cf-rm__nimbi-one" data-cf-rm-nimbi set:html={nimbiSvg(n, { size: 120 })} />)}
      </span>
    </figure>
  </div>

  <div class="cf-rm__list" data-cf-rm-acc="single">
    {c.items.map((f, i) => (
      <div class="cf-rm__item" data-cf-rm-in="item">
        <h3 class="cf-rm__q">
          <button class="cf-rm__btn" type="button" id={`cf-rm-q-${i}`} aria-expanded={i === 0 ? "true" : "false"} aria-controls={`cf-rm-a-${i}`} data-cf-rm-btn>
            <span>{f.q}</span>
            <svg class="cf-rm__chev" viewBox="0 0 14 8" aria-hidden="true" focusable="false"><path d="M.7.7 7 7 13.3.7" /></svg>
          </button>
        </h3>
        <div class="cf-rm__panel" id={`cf-rm-a-${i}`} role="region" aria-labelledby={`cf-rm-q-${i}`} data-cf-rm-panel>
          <p>{f.a}</p>
        </div>
      </div>
    ))}
  </div>
</section>
