---
// FAQ: layout of Collectify «ref-rumo-faq» (src/collectify/ref-rumo-faq), reduced for Nimbo:
// the header on the left, the questions on the right, one answer open at a time.
import copy from "../copy/faq.js";

const { lang = "it" } = Astro.props;
const c = copy[lang] || copy.it;
---

<section class="cf-rm" id="domande" data-cf-rm data-theme="light" aria-labelledby="cf-rm-title">
  <div class="nb-wrap cf-rm__grid">
    <header class="nb-head cf-rm__intro">
      <h2 class="nb-h2" id="cf-rm-title" data-cf-line-reveal="scroll">{c.title}</h2>
      <p class="nb-lede" data-cf-reveal>{c.sub}</p>
    </header>

    <div class="cf-rm__list" data-cf-rm-acc="single">
      {c.items.map((f, i) => (
        <div class="cf-rm__item" data-cf-reveal>
          <h3 class="cf-rm__q">
            <button class="cf-rm__btn" type="button" id={`cf-rm-q-${i}`} aria-expanded={i === 0 ? "true" : "false"} aria-controls={`cf-rm-a-${i}`} data-cf-rm-btn>
              <span>{f.q}</span>
              <svg class="cf-rm__chev" viewBox="0 0 14 8" aria-hidden="true" focusable="false"><path d="M.7.7 7 7 13.3.7" /></svg>
            </button>
          </h3>
          <div class="cf-rm__panel" id={`cf-rm-a-${i}`} role="region" aria-labelledby={`cf-rm-q-${i}`} inert={i === 0 ? undefined : true} data-cf-rm-panel>
            <div><p>{f.a}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
