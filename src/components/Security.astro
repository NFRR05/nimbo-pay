---
// Security and data: four plain facts about where data lives and who can see it.
// No certification logos or badges: only what the product does.
import copy from "../copy/security.js";

const { lang = "it" } = Astro.props;
const c = copy[lang] || copy.it;
---

<section class="nb-section" id="sicurezza" data-theme="light" aria-labelledby="security-title">
  <div class="nb-wrap">
    <header class="nb-head">
      <h2 class="nb-h2" id="security-title" data-cf-line-reveal="scroll">{c.title}</h2>
      <p class="nb-lede" data-cf-reveal>{c.lede}</p>
    </header>
    <dl class="nb-facts">
      {c.facts.map(([term, text]) => (
        <div class="nb-fact" data-cf-reveal>
          <dt>{term}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
