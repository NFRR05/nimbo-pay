---
// Products: the stacking cards of Collectify «ref-travelora-features» (src/collectify/ref-travelora-features).
// One white card per product over the dark section; the product's colour mark stands in 3D on the top edge
// of its card, on the left (each one a little further right, so in the stack they make a staircase), then the
// name, a title, one sentence and three specs. The marks are the only colour on the page.
import { markPerch } from "../lib/brand.js";
import copy from "../copy/products.js";

const { lang = "it" } = Astro.props;
const c = copy[lang] || copy.it;
---

<section class="cf-tv" id="prodotti" data-cf-tv data-theme="dark" aria-labelledby="products-title">
  <div class="nb-wrap">
    <header class="nb-head cf-tv__head">
      <h2 class="nb-h2" id="products-title" data-cf-line-reveal="scroll">{c.title}</h2>
      <p class="nb-lede" data-cf-reveal>{c.lede}</p>
    </header>
  </div>

  <ol class="cf-tv__stack" role="list" aria-label={c.listLabel} tabindex="0">
    {c.cards.map((card, i) => (
      <li class="cf-tv__card" style={`--i: ${i}`} data-cf-tv-card={card.id} data-nb-perch-host>
        <Fragment set:html={markPerch(card.mark, { delay: i * 1.7, className: "cf-tv__perch" })} />
        <p class="cf-tv__area">{card.area}</p>
        <div class="cf-tv__copy">
          <h3 class="cf-tv__title">{card.title}</h3>
          <p class="cf-tv__text">{card.text}</p>
        </div>
        <dl class="cf-tv__specs">
          {card.specs.map(([term, value]) => (
            <div>
              <dt>{term}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </li>
    ))}
  </ol>
</section>
