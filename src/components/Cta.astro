---
// Final call to action: one dark panel with the title, a line of text and the two actions.
import copy from "../copy/cta.js";

const { lang = "it" } = Astro.props;
const c = copy[lang] || copy.it;
const arrow = `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 12h15M13.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
---

<section class="nb-section nb-cta" id="finale" data-theme="light" aria-labelledby="final-title">
  <div class="nb-wrap">
    <div class="nb-cta__panel" data-theme="dark">
      <div>
        <h2 class="nb-h2" id="final-title">{c.title}</h2>
        <p class="nb-lede">{c.text}</p>
      </div>
      <div class="nb-actions">
        <a class="nb-btn nb-btn--solid" href="#finale">{c.primary}<Fragment set:html={arrow} /></a>
        <a class="nb-btn nb-btn--line" href="#finale">{c.secondary}<Fragment set:html={arrow} /></a>
      </div>
    </div>
  </div>
</section>
