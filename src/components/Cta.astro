---
// Final call to action: layout and motion of Collectify «ref-dark-cta» (src/collectify/ref-dark-cta),
// in black and white. Without the review card the text sits in the middle, and the five coloured marks
// (one per product) stand in the glow at the bottom of the card, in live 3D (src/lib/marks3d.js).
import { iconSvg } from "../lib/icons.js";
import copy from "../copy/cta.js";

const { lang = "it" } = Astro.props;
const c = copy[lang] || copy.it;
const arrow = iconSvg("arrow-right", { size: 16 });
---

<section class="cf-dk" id="finale" data-cf-dk data-theme="dark" aria-labelledby="final-title">
  <div class="cf-dk__stack">
    <span class="cf-dk__ghost cf-dk__ghost--back" aria-hidden="true" data-cf-dk-ghost></span>
    <span class="cf-dk__ghost cf-dk__ghost--mid" aria-hidden="true" data-cf-dk-ghost></span>

    <div class="cf-dk__card" data-cf-dk-card>
      <div class="cf-dk__fx" aria-hidden="true">
        <canvas class="cf-dk__dots" data-cf-dk-dots></canvas>
        <span class="cf-dk__glow" data-cf-dk-glow></span>
      </div>

      <div class="cf-dk__copy">
        <h2 class="cf-dk__title" id="final-title">
          {c.lines.map((line) => (
            <>
              <span class="cf-dk__line" data-cf-dk-in="line">{line}</span>{" "}
            </>
          ))}
        </h2>
        <p class="cf-dk__lede" data-cf-dk-in="copy">{c.text}</p>
        <div class="cf-dk__actions" data-cf-dk-in="copy">
          <button class="cf-dk__btn cf-dk__btn--ghost" type="button" data-cf-dk-demo>{c.secondary}</button>
          <button class="cf-dk__btn cf-dk__btn--light" type="button" data-cf-dk-demo>{c.primary}<Fragment set:html={arrow} /></button>
        </div>
        <p class="cf-dk__status" role="status" data-cf-dk-status={c.status}></p>
      </div>

      <div class="cf-dk__lineup nb-marks3d" role="img" aria-label={c.lineupLabel} data-nb-marks3d="lineup">
        <img class="nb-marks3d__poster" data-nb-marks3d-poster src="/media/marks/lineup.webp" width="1120" height="317" alt="" decoding="async" loading="lazy" />
      </div>
    </div>
  </div>
</section>
