---
// Final call to action: layout and motion of Collectify «ref-refit-contact» (src/collectify/ref-refit-contact),
// with the Nimbo identity: black box with the heading, three facts and a white form beside it.
// No badge and no social icons. The form sends nothing: on submit it says that Nimbo is a demo.
import copy from "../copy/cta.js";

const { lang = "it" } = Astro.props;
const c = copy[lang] || copy.it;
const f = c.fields;
const arrow = `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 12h15M13.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
const req = `<span class="cf-rf-form__req" aria-hidden="true">*</span>`;
---

<section class="cf-rf cf-rf-contact" id="finale" data-cf-rf="contact" data-theme="light" aria-labelledby="final-title">
  <div class="cf-rf-contact__box" data-theme="dark">
    <div class="cf-rf-wrap cf-rf-contact__grid">
      <div class="cf-rf-contact__info" data-cf-rf-reveal>
        <h2 class="nb-h2 cf-rf-h2" id="final-title">{c.title}</h2>
        <p class="cf-rf-lede">{c.lede}</p>
        <dl class="cf-rf-contact__lines">
          {c.facts.map(([term, text]) => (
            <div><dt>{term}</dt><dd>{text}</dd></div>
          ))}
        </dl>
      </div>

      <form class="cf-rf-form" method="dialog" aria-label={c.formLabel} data-cf-rf-reveal data-cf-rf-form data-cf-rf-sent={c.sent}>
        <label class="cf-rf-form__field">
          <span class="cf-rf-form__label">{f.name.label}<Fragment set:html={req} /></span>
          <span class="cf-rf-form__box"><input type="text" name="name" placeholder={f.name.placeholder} autocomplete="name" required /></span>
        </label>
        <label class="cf-rf-form__field">
          <span class="cf-rf-form__label">{f.email.label}<Fragment set:html={req} /></span>
          <span class="cf-rf-form__box"><input type="email" name="email" placeholder={f.email.placeholder} autocomplete="email" required /></span>
        </label>
        <label class="cf-rf-form__field">
          <span class="cf-rf-form__label">{f.company.label}</span>
          <span class="cf-rf-form__box"><input type="text" name="company" placeholder={f.company.placeholder} autocomplete="organization" /></span>
        </label>
        <label class="cf-rf-form__field">
          <span class="cf-rf-form__label">{f.message.label}<Fragment set:html={req} /></span>
          <span class="cf-rf-form__box cf-rf-form__box--area"><textarea name="message" placeholder={f.message.placeholder} required></textarea></span>
        </label>
        <button class="cf-rf-form__submit" type="submit">{c.submit}<Fragment set:html={arrow} /></button>
        <p class="cf-rf-form__status" role="status" data-cf-rf-status></p>
      </form>
    </div>
  </div>
</section>
