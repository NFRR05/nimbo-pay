---
// Numbers: layout and motion of Collectify «ref-stepout-stats» (src/collectify/ref-stepout-stats),
// redrawn for Nimbo: the green card is black, the sage cards neutral, Outfit numbers whose characters
// get heavier near the pointer. No pill bar, no icons: the numbers carry the section.
import copy from "../copy/numbers.js";

const { t, lang = "it" } = Astro.props;
const c = copy[lang] || copy.it;
const locale = t?.locale || (lang === "en" ? "en-IE" : "it-IT");
const kinds = ["cf-so__card cf-so__card--main", "cf-so__card cf-so__card--tint", "cf-so__card"];
const digits = (n) => String(n).split("");
---

<section class="cf-so" data-cf-so data-cf-so-locale={locale} aria-labelledby="numbers-title">
  <h2 class="cf-so__title" id="numbers-title">
    {c.lines.map((line) => (
      <>
        <span class="cf-so__line"><span class="cf-so__line-in" data-cf-so-in="line">{line}</span></span>{" "}
      </>
    ))}
  </h2>

  <ul class="cf-so__cards" role="list" data-cf-so-cards>
    {c.cards.map((card, i) => (
      <li class={kinds[i]} data-cf-so-in="card" data-cf-so-card>
        <p class="cf-so__num" data-cf-so-num data-cf-so-count={card.value} data-cf-so-from={card.from}>
          <span class="cf-so__sr">{(card.prefix || "") + card.value + (card.suffix || "")}</span>
          <span class="cf-so__chars" aria-hidden="true">
            {card.prefix && <span class="cf-so__ch cf-so__ch--unit">{card.prefix}</span>}
            {digits(Math.max(card.value, card.from || 0)).map((_, j, arr) => (
              <span class="cf-so__ch" data-cf-so-digit>{String(card.value).padStart(arr.length, " ")[j].trim()}</span>
            ))}
            {card.suffix && <span class="cf-so__ch cf-so__ch--unit">{card.suffix}</span>}
          </span>
        </p>
        <p class="cf-so__caption">{card.caption}</p>
      </li>
    ))}
  </ul>
</section>
