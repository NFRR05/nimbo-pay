---
// The five colour marks introduce themselves: one row each, the mark in 3D on one side (alternating left and
// right) and what it does, in its own words, in a speech bubble on the other. The words light up as the bubble
// scrolls past (Collectify «scroll-word-fill») and the mark bobs as if talking while you scroll through them
// (src/lib/marks3d.js, "solo" mode: one shared renderer for all five). A still poster stands in without
// script, without WebGL and with reduced motion, where the words are simply there.
import copy from "../copy/talk.js";

const { lang = "it" } = Astro.props;
const c = copy[lang] || copy.it;
---

<section class="nb-talk" id="nimbi" data-theme="light" aria-labelledby="talk-title">
  <div class="nb-wrap">
    <header class="nb-head nb-talk__head">
      <h2 class="nb-h2" id="talk-title" data-cf-line-reveal="scroll">{c.title}</h2>
      <p class="nb-lede" data-cf-reveal>{c.lede}</p>
    </header>

    <ol class="nb-talk__list" role="list">
      {c.items.map((item, i) => (
        <li class:list={["nb-talk__row", { "is-flip": i % 2 === 1 }]} data-nb-talk-row>
          <div class="nb-talk__mark" data-nb-marks3d="solo" data-nb-color={item.mark} data-nb-side={i % 2 === 1 ? "left" : "right"} aria-hidden="true">
            <img class="nb-talk__poster" data-nb-marks3d-poster src={`/media/marks/talk-${item.mark}-${i % 2 === 1 ? "l" : "r"}.webp`} width="640" height="720" alt="" decoding="async" loading="lazy" />
          </div>
          <div class="nb-talk__bubble" data-cf-reveal>
            <p class="nb-talk__who">{item.name}</p>
            <p class="nb-talk__say" data-nb-talk-text data-cf-word-fill data-cf-from="0.16" data-cf-start="top 82%" data-cf-end="bottom 58%">{item.say}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
